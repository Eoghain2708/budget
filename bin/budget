#!/usr/bin/env ruby

require_relative '../lib/budget'
PASTEL = Pastel.new

begin
  CLI.new.run(ARGV)
rescue TTY::Reader::InputInterrupt, Interrupt
  puts ''
  puts PASTEL.bright_red.bold 'Cancelled.'
rescue Date::Error
  puts ''
  puts PASTEL.bright_red.bold 'Invalid date'
rescue OptionParser::InvalidOption
  puts ''
  puts PASTEL.bright_red.bold('Invalid option')
end
